{
  "name": "zerodb-memory",
  "description": "Persistent cross-session memory for Claude Code, powered by ZeroDB",
  "version": "1.0.1",
  "author": {
    "name": "AINative Studio",
    "email": "support@ainative.studio"
  },
  "mcpServers": {
    "zerodb-memory": {
      "command": "npx",
      "args": [
        "-y",
        "ainative-zerodb-memory-mcp@latest"
      ],
      "env": {
        "ZERODB_API_KEY": "${ZERODB_API_KEY}",
        "ZERODB_PROJECT_ID": "${ZERODB_PROJECT_ID}"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-end.sh"
          }
        ]
      }
    ]
  },
  "statusline": "statusline/zerodb-status.sh"
}
